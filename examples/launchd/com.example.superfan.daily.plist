<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Daily review at 21:00. Copy to ~/Library/LaunchAgents/, replace every
  /PATH/TO/... and YOUR-NAME, then:  launchctl load ~/Library/LaunchAgents/com.example.superfan.daily.plist
  Reviews land in ~/.superfan/reviews and show in the page's Reviews tab.
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.superfan.daily</string>
  <key>WorkingDirectory</key><string>/PATH/TO/harness-superfan</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string><string>-m</string><string>superfan</string>
    <string>review</string><string>--day</string><string>--quiet</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <!-- where `which claude` and `which codex` point; launchd does not read your shell profile -->
    <key>PATH</key><string>/PATH/TO/CLAUDE/BIN:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardErrorPath</key><string>/Users/YOUR-NAME/.superfan/launchd-daily.log</string>
</dict>
</plist>
